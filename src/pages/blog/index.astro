---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";

const posts: CollectionEntry<"posts">[] = (
  await getCollection(
    "posts",
    ({ data }: CollectionEntry<"posts">) => !data.draft,
  )
).sort(
  (a: CollectionEntry<"posts">, b: CollectionEntry<"posts">) =>
    +b.data.date - +a.data.date,
);

const fmt = (d: Date): string =>
  `${String(d.getDate()).padStart(2, "0")}.${String(d.getMonth() + 1).padStart(
    2,
    "0",
  )}.${d.getFullYear()}`;

const headlineParts = (headline: string): [string, string] => {
  const [before = "", after = ""] = headline.split("{emphasis}");
  return [before, after];
};
---

<PageLayout
  title="The Blog"
  eyebrow="Journal"
  description="Essays, Techincal field notes."
>
  <div class="post-list">
    {
      posts.map((post) => {
        const [beforeEmphasis, afterEmphasis] = headlineParts(post.data.headline);

        return (
          <a class="post-card" href={`/blog/${post.id}`}>
            <div class="post-card__cover">
              <img src={post.data.cover} alt="" loading="lazy" />
            </div>

            <div>
              <div class="post-card__meta">
                {fmt(post.data.date)} · {post.data.author} ·{" "}
                {post.data.readTime}
              </div>

              <h2 class="post-card__title">
                {post.data.emphasis ? (
                  <span class="post-card__headline">
                    {beforeEmphasis}
                    <em>{post.data.emphasis}</em>
                    {afterEmphasis}
                  </span>
                ) : (
                  post.data.headline
                )}
              </h2>

              <p class="post-card__excerpt">{post.data.excerpt}</p>

              {post.data.tags.length > 0 && (
                <div class="post-card__tags">
                  {post.data.tags.map((tag: string) => (
                    <span>{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        );
      })
    }
  </div>
</PageLayout>
