---
interface Props {
  bigTitle: string;
  date: Date;
  emphasis?: string;
  headline: string;
  cover: string;
  author: string;
  readTime: string;
  excerpt: string;
  href: string;
}

const {
  bigTitle,
  date,
  emphasis,
  headline,
  cover,
  author,
  readTime,
  excerpt,
  href
} = Astro.props;

const formatted = new Intl.DateTimeFormat('en-GB', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
})
  .format(date)
  .replaceAll('/', '.');

const parts = emphasis
  ? headline.split('{emphasis}')
  : [headline];
---

<div class="blog-header">

  <!-- LEFT PANE -->
  <div class="blog-pane blog-pane--title">
    <div class="blog-big__title">
      {bigTitle}
    </div>

    <div class="blog-menu small-title date">
      {formatted}
    </div>
  </div>

  <!-- CENTER PANE -->
  <article class="blog-pane blog-pane--feature">
    <img src={cover} alt={bigTitle} />

    <h2>
      {
        emphasis ? (
          <>
            {parts[0]}
            <span>{emphasis}</span>
            {parts[1]}
          </>
        ) : (
          headline
        )
      }
    </h2>

    <div class="blog-detail">
      <span>By {author}</span>
      <span>{readTime}</span>
    </div>

    <p>{excerpt}</p>

    <a href={href}>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="feather feather-corner-down-right"
        viewBox="0 0 24 24"
      >
        <path d="M15 10l5 5-5 5"></path>
        <path d="M4 4v7a4 4 0 004 4h12"></path>
      </svg>

      See More
    </a>
  </article>

  <!-- RIGHT PANE -->
  <aside class="blog-pane blog-pane--meta">
    <div class="meta-block">
      <div class="meta-label">Category</div>
      <div class="meta-value">Featured Essay</div>
    </div>

    <div class="meta-block">
      <div class="meta-label">Reading Time</div>
      <div class="meta-value">{readTime}</div>
    </div>

    <div class="meta-block">
      <div class="meta-label">Author</div>
      <div class="meta-value">{author}</div>
    </div>

    <div class="meta-block">
      <div class="meta-label">Published</div>
      <div class="meta-value">{formatted}</div>
    </div>
  </aside>

</div>